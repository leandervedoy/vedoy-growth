# Supabase (publishable values used by the browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key

# Supabase admin key (server only; never prefix with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Canonical production URL
NEXT_PUBLIC_SITE_URL=https://growth.vedoy.store

# Optional: raises the quota for automated Google PageSpeed checks
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key

# Google Analytics Data API + Search Console (server only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=vedoy-growth@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Optional website alert email delivery (server only)
RESEND_API_KEY=re_your_resend_api_key
ALERT_FROM_EMAIL=Vedoy Growth <varsler@your-verified-domain.no>

# Shopify Admin API (server only)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_token

# Instagram / Meta Graph API (server only)
INSTAGRAM_USER_ID=your_instagram_business_user_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_meta_token
