# Public learning site works without a database. Keep the workspace closed.
GROWTH_WORKSPACE_OPEN=false

# Dedicated, approved launch database only. Server-side variables; never NEXT_PUBLIC.
# Leave both empty until the standalone migration, SMTP and Auth checks are complete.
GROWTH_SUPABASE_URL=
GROWTH_SUPABASE_PUBLISHABLE_KEY=

# Do not copy credentials for the older workspace into this deployment.
# See docs/launch-readiness.md for activation and docs/legacy-workspace.md for old notes.
